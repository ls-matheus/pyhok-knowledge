{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PyHokSignalDefinition",
  "type": "object",
  "required": [
    "id",
    "source",
    "type",
    "unit",
    "normalized",
    "min_quality_threshold"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sig_[a-z0-9_]+$"
    },
    "source": {
      "type": "string",
      "enum": [
        "pointer",
        "keyboard",
        "camera_gaze",
        "camera_face",
        "microphone",
        "system"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "scalar",
        "vector2d",
        "event_stream"
      ]
    },
    "unit": {
      "type": "string"
    },
    "normalized": {
      "type": "boolean"
    },
    "min_quality_threshold": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "additionalProperties": false
}
