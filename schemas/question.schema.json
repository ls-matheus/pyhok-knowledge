{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PyHokQuestionEntity",
  "type": "object",
  "required": [
    "id",
    "hypothesis",
    "required_signals",
    "evaluation_trigger",
    "evidence_impact",
    "cortex_weights"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^q_[a-z0-9_]+$"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "required_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sig_[a-z0-9_]+$"
      },
      "minItems": 1
    },
    "evaluation_trigger": {
      "type": "object",
      "required": [
        "rules",
        "logical_operator"
      ],
      "properties": {
        "logical_operator": {
          "type": "string",
          "enum": [
            "AND",
            "OR"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "signal_id",
              "operator",
              "threshold",
              "window_ms"
            ],
            "properties": {
              "signal_id": {
                "type": "string",
                "pattern": "^sig_[a-z0-9_]+$"
              },
              "operator": {
                "type": "string",
                "enum": [
                  ">",
                  "<",
                  ">=",
                  "<=",
                  "==",
                  "!="
                ]
              },
              "threshold": {
                "type": "number"
              },
              "window_ms": {
                "type": "integer",
                "minimum": 100
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_impact": {
      "type": "object",
      "required": [
        "base_strength",
        "decay_rate_per_sec"
      ],
      "properties": {
        "base_strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "decay_rate_per_sec": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    },
    "cortex_weights": {
      "type": "object",
      "required": [
        "focus",
        "stress",
        "autonomy",
        "fatigue"
      ],
      "properties": {
        "focus": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "stress": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "autonomy": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "fatigue": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
