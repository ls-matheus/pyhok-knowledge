{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pyhok.org/schema/v2/question.schema.json",
  "title": "PyHokQuestionEntity",
  "description": "Extensible observational hypothesis evaluated by the Sinapse engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hypothesis",
    "required_signals",
    "evaluation_trigger",
    "evidence_model",
    "cortex_weights"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^q_[a-z0-9_]+$"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "required_signals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sig_[a-z0-9_]+$"
      }
    },
    "evaluation_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_operator",
        "rules"
      ],
      "properties": {
        "logical_operator": {
          "type": "string",
          "enum": [
            "AND",
            "OR"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal_id",
              "operator",
              "threshold",
              "window_ms"
            ],
            "properties": {
              "signal_id": {
                "type": "string",
                "pattern": "^sig_[a-z0-9_]+$"
              },
              "operator": {
                "type": "string",
                "enum": [
                  ">",
                  "<",
                  ">=",
                  "<=",
                  "==",
                  "!="
                ]
              },
              "threshold": {
                "type": "number"
              },
              "window_ms": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "evidence_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_strength",
        "decay_rate_per_sec"
      ],
      "properties": {
        "base_strength": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "decay_rate_per_sec": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "cortex_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus",
        "stress",
        "autonomy",
        "fatigue"
      ],
      "properties": {
        "focus": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "stress": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "autonomy": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "fatigue": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        }
      }
    }
  }
}
