{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pyhok.org/schema/v2/signal-value.schema.json",
  "title": "PyHokRuntimeSignalValue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "timestamp_ms",
    "status",
    "quality"
  ],
  "properties": {
    "signal_id": {
      "type": "string",
      "pattern": "^sig_[a-z0-9_]+$"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "VALID",
        "DEGRADED",
        "MISSING",
        "INVALID"
      ]
    },
    "value": {},
    "quality": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
