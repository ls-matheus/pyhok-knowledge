{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pyhok.org/schema/v2/provenance.schema.json",
  "title": "PyHokEpistemicProvenance",
  "description": "Epistemic provenance tracking and lineage metadata for PyHok knowledge entities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epistemic_status",
    "derived_from",
    "evidence_roots",
    "derivation_depth",
    "independent_evidence_count",
    "generator_model"
  ],
  "properties": {
    "epistemic_status": {
      "type": "string",
      "enum": [
        "EXTERNAL_FACT",
        "OBSERVATION",
        "DERIVED",
        "HYPOTHESIS",
        "SPECULATION"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^q_[a-z0-9_]+$"
      }
    },
    "evidence_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(sig|ext)_[a-z0-9_]+$"
      }
    },
    "derivation_depth": {
      "type": "integer",
      "minimum": 0
    },
    "independent_evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "generator_model": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^cycle_[a-z0-9_]+$"
    },
    "judge_ruling": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
